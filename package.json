{
  "name": "runlocally",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "description": "Open, fix and repack ZIP files in your browser. Nothing is uploaded.",
  "homepage": "https://runlocally.app/",
  "repository": "https://github.com/GeppettoAndRomero/runlocally",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint .",
    "license:check": "license-checker --production --excludePrivatePackages --summary --onlyAllow \"MIT;ISC;BSD-2-Clause;BSD-3-Clause;Apache-2.0;0BSD;CC0-1.0;Unlicense;LGPL-3.0;LGPL-3.0-or-later;LGPL-2.1;LGPL-2.1-or-later;Python-2.0;CC-BY-4.0\"",
    "check-leaks": "bash scripts/check-leaks.sh",
    "check:engine-dom": "bash scripts/check-engine-dom.sh",
    "test": "vitest run",
    "test:unit": "vitest run",
    "size": "size-limit",
    "prepare": "git config core.hooksPath .githooks || true",
    "ci": "npm run typecheck && npm run lint && npm run license:check && npm run check-leaks && npm run check:engine-dom && npm run test:unit -- --coverage && npm run build && npm run size",
    "postinstall": "node scripts/vendor-libarchive.mjs",
    "prebuild": "node scripts/vendor-libarchive.mjs",
    "predev": "node scripts/vendor-libarchive.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "^3.5.3",
    "@zip.js/zip.js": "^2.18.2",
    "astro": "^4.16.18",
    "libarchive.js": "2.0.2",
    "preact": "^10.24.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^9.39.4",
    "@size-limit/file": "^11.0.0",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^16.0.0",
    "license-checker": "^25.0.1",
    "size-limit": "^11.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^2.1.9"
  },
  "size-limit": [
    {
      "name": "precache",
      "path": "dist/**/*.{js,css,html}",
      "limit": "200 KB"
    }
  ]
}
