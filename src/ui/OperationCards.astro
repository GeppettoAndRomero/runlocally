---
import type { Locale } from '../i18n/locales';
import { operationLabel, AVAILABLE_OPS } from '../i18n/ops';
import { pageContent } from '../i18n/pages';
import { chromeUi, menuUi, ui } from '../i18n/ui';
import { pagePath } from '../seo/page';

// One navigation, in the page's own language. src/app/page-display.ts rebuilds it when the language changes.
const { locale } = Astro.props as { locale: Locale };
---
<nav class="operation-cards page-content" data-operation-cards data-lang={locale} aria-label={chromeUi[locale].navigation}>
  <div class="operation-cards__grid">
    {AVAILABLE_OPS.map(op =>
      <article class="operation-cards__card">
        <h2><a href={pagePath(locale, op.id)}>{operationLabel(op, ui[locale].workbench, menuUi[locale])}</a></h2>
        <p>{pageContent(locale, op.id).description}</p>
      </article>
    )}
  </div>
</nav>
