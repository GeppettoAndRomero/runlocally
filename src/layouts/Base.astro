---
import '../styles/tokens.css';
import '../styles/base.css';
import '../ui/components.css';
import '../styles/chrome.css';
import { LOCALES, type Locale } from '../i18n/locales';
import { AVAILABLE_OPS } from '../i18n/ops';
import type { PageContent } from '../i18n/types';
import type { HubContent } from '../i18n/hub';
import { alternates, checkMetadataLength, headData, ogLocale, pagePath, pageUrl, type PublicPage } from '../seo/page';
import { chromeUi, ui } from '../i18n/ui';
import { PwaStartup } from '../ui/PwaStartup';

interface Props {
  lang: Locale;
  title?: string;
  description?: string;
  page?: PublicPage;
  content?: PageContent | HubContent;
}

const { lang, page = 'top', content } = Astro.props;
const title = content?.title ?? Astro.props.title ?? '';
const description = content?.description ?? Astro.props.description ?? '';
const metadata = content ? headData(lang, page, content) : undefined;
if (!content) checkMetadataLength(lang, page, title, description);
const canonical = metadata?.canonical ?? pageUrl(lang, page);
const links = metadata?.alternates ?? alternates(page);
const localeInfo = LOCALES.find(entry => entry.code === lang)!;
const og = metadata?.og ?? {
  type: 'website', url: canonical, title, description, siteName: 'runlocally',
  locale: ogLocale(lang),
  alternateLocales: LOCALES.filter(entry => entry.code !== lang).map(entry => ogLocale(entry.code)),
};
---
<!doctype html>
<html lang={localeInfo.code} data-zip-top={page === 'top' ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#4f46e5" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/app-192.png" />
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    {links.map(link => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}
    <meta property="og:type" content={og.type} />
    <meta property="og:url" content={og.url} />
    <meta property="og:title" content={og.title} />
    <meta property="og:description" content={og.description} />
    <meta property="og:site_name" content={og.siteName} />
    <meta property="og:locale" content={og.locale} />
    {og.alternateLocales.map(locale => <meta property="og:locale:alternate" content={locale} />)}
    {metadata && <script type="application/ld+json" set:html={metadata.jsonLd} />}
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-header__brand" data-chrome-home href={pagePath(lang, 'top')} aria-label={chromeUi[lang].home} aria-current={page === 'top' ? 'page' : undefined}>runlocally</a>
        {page !== 'hub' && <nav class="site-nav" aria-label={chromeUi[lang].navigation} data-chrome-nav>
          {AVAILABLE_OPS.map(op => <a data-chrome-page={op.id} href={pagePath(lang, op.id)} aria-current={page === op.id ? 'page' : undefined}>{ui[lang].workbench[op.i18nKey]}</a>)}
        </nav>}
        <nav class="site-languages" aria-label={chromeUi[lang].languages} data-chrome-languages>
          {LOCALES.map(locale => <a data-chrome-locale={locale.code} href={pagePath(locale.code, page)} aria-current={lang === locale.code ? 'page' : undefined}>{locale.name}</a>)}
        </nav>
      </div>
    </header>
    <slot />
    {page === 'hub' && <PwaStartup locale={lang} client:load />}
    <footer class="site-footer">
      <p>Some code was written with AI assistance; all review and decisions are the maintainer's.</p>
      <a id="footer-security" href="/SECURITY.md">{ui[lang].shared.security}</a>
    </footer>
  </body>
</html>
