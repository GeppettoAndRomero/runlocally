---
import '../styles/tokens.css';
import '../styles/base.css';
import '../ui/components.css';
import '../styles/chrome.css';
import { DEFAULT_LOCALE, ENGLISH_LOCALE, LOCALES, type Locale } from '../i18n/locales';
import { operationLabel, AVAILABLE_OPS } from '../i18n/ops';
import type { PageContent } from '../i18n/types';
import type { ImagePageContent } from '../i18n/image-page';
import type { HubContent } from '../i18n/hub';
import { alternates, checkMetadataLength, headData, ogLocale, pagePath, pageUrl, type SitePage } from '../seo/page';
import { chromeUi, menuUi, ui } from '../i18n/ui';
import { PwaStartup } from '../ui/PwaStartup';
import { repository } from '../../package.json';

interface Props {
  lang: Locale;
  title?: string;
  description?: string;
  page?: SitePage;
  content?: PageContent | HubContent | ImagePageContent;
}

const { lang, page = 'top', content } = Astro.props;
const title = content?.title ?? Astro.props.title ?? '';
const description = content?.description ?? Astro.props.description ?? '';
const metadata = content ? headData(lang, page, content) : undefined;
if (!content) checkMetadataLength(lang, page, title, description);
const canonical = metadata?.canonical ?? pageUrl(lang, page);
const links = metadata?.alternates ?? alternates(page);
const localeInfo = LOCALES.find(entry => entry.code === lang)!;
const og = metadata?.og ?? {
  type: 'website', url: canonical, title, description, siteName: 'runlocally',
  locale: ogLocale(lang),
  alternateLocales: LOCALES.filter(entry => entry.code !== lang).map(entry => ogLocale(entry.code)),
};
---
<!doctype html>
<html lang={localeInfo.code} data-zip-top={page === 'top' ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#4f46e5" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/app-192.png" />
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <meta name="description" content={description} />
    {metadata?.robots && <meta name="robots" content={metadata.robots} />}
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    {links.map(link => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}
    <meta property="og:type" content={og.type} />
    <meta property="og:url" content={og.url} />
    <meta property="og:title" content={og.title} />
    <meta property="og:description" content={og.description} />
    <meta property="og:site_name" content={og.siteName} />
    <meta property="og:locale" content={og.locale} />
    {og.alternateLocales.map(locale => <meta property="og:locale:alternate" content={locale} />)}
    {metadata && <script type="application/ld+json" set:html={metadata.jsonLd} />}
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-header__brand" data-chrome-home href={pagePath(lang, 'hub')} aria-label={chromeUi[lang].home} aria-current={page === 'hub' ? 'page' : undefined}>runlocally</a>
        {page !== 'hub' && page !== 'image' && <nav class="site-nav" aria-label={chromeUi[lang].navigation} data-chrome-nav>
          {AVAILABLE_OPS.map(op => <a data-chrome-page={op.id} href={pagePath(lang, op.id)} aria-current={page === op.id ? 'page' : undefined}>{operationLabel(op, ui[lang].workbench, menuUi[lang])}</a>)}
        </nav>}
        <nav class="site-languages" aria-label={chromeUi[lang].languages} data-chrome-languages>
          {LOCALES.map(locale => <a data-chrome-locale={locale.code} href={pagePath(locale.code, page)} aria-current={lang === locale.code ? 'page' : undefined}>{locale.name}</a>)}
        </nav>
      </div>
    </header>
    <slot />
    {page === 'hub' && <PwaStartup locale={lang} client:load />}
    <footer class="site-footer">
      <div data-trust-locale={DEFAULT_LOCALE} lang={DEFAULT_LOCALE}>
        <p>無料で使えるブラウザアプリです。</p>
        <p>コードの一部は AI の支援で書かれています。レビューと判断はすべて運営者が行っています。</p>
        <p><a data-trust-link="source" href={repository}>ソースコード（GitHub）</a> · <a data-trust-link="issues" href={`${repository}/issues`}>不具合・ご意見（GitHub Issues）</a></p>
        <p>脆弱性の報告は、下のセキュリティ窓口をご利用ください。</p>
      </div>
      <div data-trust-locale={ENGLISH_LOCALE} lang={ENGLISH_LOCALE}>
        <p>A free app that runs in your browser.</p>
        <p>Some code was written with AI assistance; all review and decisions are the maintainer's.</p>
        <p><a data-trust-link="source" href={repository}>Source code (GitHub)</a> · <a data-trust-link="issues" href={`${repository}/issues`}>Bugs and feedback (GitHub Issues)</a></p>
        <p>To report a vulnerability, use the Security link below.</p>
      </div>
      <a id="footer-security" href="/SECURITY.md">{ui[lang].shared.security}</a>
    </footer>
  </body>
</html>

<style is:global>
  .site-footer [data-trust-locale] { display: none; overflow-wrap: anywhere; }
  html[lang="ja"] .site-footer [data-trust-locale="ja"],
  html[lang="en"] .site-footer [data-trust-locale="en"] { display: block; }
</style>
